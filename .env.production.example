# EXAMPLE ONLY. On VPS use /opt/clinic-schedule/.env with chmod 600.
# Do not publish actual values to GitHub.
APP_DOMAIN=clinic.example.com
ACME_EMAIL=you@example.com
BASIC_AUTH_USER=clinic
# Generate with Caddy (bcrypt). Single quotes preserve dollar signs in .env.
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_REAL_HASH'
# URL-safe random password, e.g. openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Pinned immutable release, written by CI/CD (not "latest").
IMAGE_TAG=v1.0.0
